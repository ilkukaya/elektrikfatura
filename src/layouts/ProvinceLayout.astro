---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  provinceName: string;
  breadcrumbs: Array<{ label: string; href: string }>;
  canonical?: string;
  schemaMarkup?: string;
}

const { title, description, provinceName, breadcrumbs, canonical, schemaMarkup } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} schemaMarkup={schemaMarkup}>
  <div class="bg-primary-600 text-white py-6">
    <div class="max-w-6xl mx-auto px-4">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="text-2xl md:text-3xl font-bold mt-2">{provinceName} Elektrik Fatura Hesaplama</h1>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <slot />
  </div>
</BaseLayout>
