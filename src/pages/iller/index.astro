---
import BaseLayout from '@layouts/BaseLayout.astro';
import provincesData from '../../../data/provinces.json';

const provinces = provincesData.provinces;

const regions = [...new Set(provinces.map((p) => p.region))].sort();

const title = 'İllere Göre Elektrik Faturası Hesaplama — 81 İl';
const description = 'Türkiye\'nin 81 ili için elektrik faturası hesaplama. İl bazlı dağıtım şirketi bilgileri ve güncel tarifeler.';
---

<BaseLayout title={title} description={description}>
  <div class="bg-primary-600 text-white py-8">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-2xl md:text-3xl font-bold">İllere Göre Elektrik Faturası Hesaplama</h1>
      <p class="text-primary-100 mt-2">81 ilin tamamı için güncel tarife ve dağıtım şirketi bilgileri</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8">
    {regions.map((region) => (
      <div class="mb-8">
        <h2 class="text-xl font-bold text-slate-800 mb-4">{region} Bölgesi</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          {provinces
            .filter((p) => p.region === region)
            .map((province) => {
              const dist = province.distributionCompany;
              const distName = typeof dist === 'object' ? dist.asian : dist;
              return (
                <a
                  href={`/iller/${province.slug}`}
                  class="block bg-white rounded-lg border border-slate-200 p-4 hover:border-primary-300 hover:shadow-sm transition-all"
                >
                  <span class="font-medium text-slate-800">{province.name}</span>
                  <p class="text-xs text-slate-500 mt-1">{distName}</p>
                </a>
              );
            })}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
