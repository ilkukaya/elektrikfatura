---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const posts = await getCollection('blog');

const title = 'Blog — Elektrik, Doğalgaz ve Su Tasarrufu İpuçları';
const description = 'Fatura tasarrufu, enerji verimliliği ve EPDK tarifeleri hakkında güncel blog yazıları.';
---

<BaseLayout title={title} description={description}>
  <div class="bg-primary-600 text-white py-8">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-2xl md:text-3xl font-bold">Blog</h1>
      <p class="text-primary-100 mt-2">Fatura tasarrufu ve enerji verimliliği hakkında güncel yazılar</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="block bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow"
        >
          <div class="p-6">
            <h2 class="text-lg font-bold text-slate-800 mb-2">{post.data.title}</h2>
            <p class="text-sm text-slate-600 line-clamp-3">{post.data.description}</p>
            <div class="flex items-center gap-4 mt-4 text-xs text-slate-400">
              <span>{new Date(post.data.date).toLocaleDateString('tr-TR')}</span>
              <span>{post.data.category}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
