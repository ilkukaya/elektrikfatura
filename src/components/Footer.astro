---
import LastUpdated from '@components/LastUpdated.astro';
---

<footer class="bg-slate-800 text-slate-300 mt-auto">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div>
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="text-lg font-bold text-white">elektrikfatura.com</span>
        </div>
        <p class="text-sm">EPDK güncel tarifeleriyle elektrik, doğalgaz ve su faturanızı kolayca hesaplayın.</p>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-3">Hesaplayıcılar</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/elektrik-fatura-hesaplama" class="hover:text-white transition-colors">Elektrik Faturası</a></li>
          <li><a href="/dogalgaz-fatura-hesaplama" class="hover:text-white transition-colors">Doğalgaz Faturası</a></li>
          <li><a href="/su-fatura-hesaplama" class="hover:text-white transition-colors">Su Faturası</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-3">Bilgi</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/elektrik-tarifeleri" class="hover:text-white transition-colors">Elektrik Tarifeleri</a></li>
          <li><a href="/elektrik-zammi" class="hover:text-white transition-colors">Elektrik Zam Geçmişi</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-3">İller</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/iller/istanbul" class="hover:text-white transition-colors">İstanbul</a></li>
          <li><a href="/iller/ankara" class="hover:text-white transition-colors">Ankara</a></li>
          <li><a href="/iller/izmir" class="hover:text-white transition-colors">İzmir</a></li>
          <li><a href="/iller" class="text-primary-400 hover:text-primary-300 transition-colors">Tüm İller →</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-700 mt-8 pt-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm">&copy; {new Date().getFullYear()} elektrikfatura.com — Tüm hakları saklıdır.</p>
      <LastUpdated />
    </div>
  </div>
</footer>
