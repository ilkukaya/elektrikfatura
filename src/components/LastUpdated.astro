---
import lastUpdatedData from '../../data/last-updated.json';

const { electricity, gas, water } = lastUpdatedData;
---

<div class="text-xs text-slate-400">
  <span class="inline-flex items-center gap-1">
    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
    </svg>
    Son güncelleme:
    <span class="font-medium">
      Elektrik: {new Date(electricity).toLocaleDateString('tr-TR')} |
      Doğalgaz: {new Date(gas).toLocaleDateString('tr-TR')} |
      Su: {new Date(water).toLocaleDateString('tr-TR')}
    </span>
  </span>
</div>
