---
interface Props {
  title: string;
  tiers: Array<{ label: string; price: string; range: string }>;
  fixedCharges?: Array<{ label: string; value: string }>;
  taxes?: Array<{ label: string; value: string }>;
}

const { title, tiers, fixedCharges = [], taxes = [] } = Astro.props;
---

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
  <div class="p-4 bg-slate-50 border-b border-slate-200">
    <h3 class="font-semibold text-slate-800">{title}</h3>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-slate-50 border-b border-slate-200">
          <th class="text-left px-4 py-3 font-medium text-slate-600">Kademe</th>
          <th class="text-left px-4 py-3 font-medium text-slate-600">Aralık</th>
          <th class="text-right px-4 py-3 font-medium text-slate-600">Birim Fiyat</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {tiers.map((tier, index) => (
          <tr class={index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>
            <td class="px-4 py-3 font-medium">Kademe {index + 1}</td>
            <td class="px-4 py-3 text-slate-600">{tier.range}</td>
            <td class="px-4 py-3 text-right font-semibold text-primary-600">{tier.price}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {fixedCharges.length > 0 && (
    <div class="border-t border-slate-200 p-4">
      <h4 class="font-medium text-slate-700 mb-2">Sabit Ücretler</h4>
      <div class="space-y-1">
        {fixedCharges.map((charge) => (
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">{charge.label}</span>
            <span class="font-medium">{charge.value}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  {taxes.length > 0 && (
    <div class="border-t border-slate-200 p-4 bg-slate-50">
      <h4 class="font-medium text-slate-700 mb-2">Vergiler ve Fonlar</h4>
      <div class="space-y-1">
        {taxes.map((tax) => (
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">{tax.label}</span>
            <span class="font-medium">{tax.value}</span>
          </div>
        ))}
      </div>
    </div>
  )}
</div>
